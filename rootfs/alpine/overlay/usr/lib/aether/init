#!/bin/sh

export HOME=/root
export SHELL=/bin/bash
export LANG=en_US.UTF-8
export PATH=/bin:/usr/bin:/usr/sbin:/sbin:/usr/local/bin:/usr/local/sbin
export XDG_RUNTIME_DIR=/run/user/0

mkdir -p /dev/shm
mount -t tmpfs tmpfs /dev/shm
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts

mkdir -p /tmp/.X11-unix /tmp/.ICE-unix "$HOME/.config/dconf" \
    /run/dbus /var/lib/dbus "$XDG_RUNTIME_DIR"
chmod 01777 /tmp/.X11-unix
chmod 0777 /tmp/.ICE-unix
chmod 0700 "$XDG_RUNTIME_DIR"

# apk.static 不运行安装脚本，缓存生成不能阻塞桌面启动。
(
    if [ ! -f /usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache ]; then
        gdk-pixbuf-query-loaders --update-cache || true
    fi
    if [ ! -f /usr/share/mime/mime.cache ]; then
        update-mime-database /usr/share/mime || true
    fi
    for icondir in /usr/share/icons/hicolor /usr/share/icons/Adwaita; do
        if [ -d "$icondir" ] && [ ! -f "$icondir/icon-theme.cache" ]; then
            gtk-update-icon-cache -f "$icondir" || true
        fi
    done
) &

dbus-uuidgen --ensure
dbus-daemon --system --fork

# Aether-OS 未运行 OpenRC，直接启动 elogind。
if [ -x /usr/libexec/elogind/elogind ]; then
    /usr/libexec/elogind/elogind --daemon
fi

SEATD_VTBOUND=0 seatd &

while [ ! -S /run/seatd.sock ]; do
    sleep 0.1
done

udevd &

while [ ! -e /run/udev/control ]; do
    sleep 0.1
done

udevadm trigger --action=add
udevadm settle

exec runuser -l root -c /usr/lib/aether/start-xfce4-session
